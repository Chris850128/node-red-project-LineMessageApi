        "id": "6f6a03916cdcf035",
        "type": "function",
        "z": "204891a7f081f671",
        "name": "格式化時間",
        "func": "var date = new Date(msg.timestampget);\nvar yyyy = date.getFullYear();\nvar mm = (\"0\" + (date.getMonth() + 1)).slice(-2);\nvar dd = (\"0\" + date.getDate()).slice(-2);\nvar hh = (\"0\" + date.getHours()).slice(-2);\nvar mi = (\"0\" + date.getMinutes()).slice(-2);\nvar ss = (\"0\" + date.getSeconds()).slice(-2);\n\n// 格式：2025/06/21 09:30:45\nmsg.timestamp_str = yyyy + \"/\" + mm + \"/\" + dd + \" \" + hh + \":\" + mi + \":\" + ss;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
